# App database (finance-dashboard-db) — MSSQL, owned by this app.
APP_DB_HOST=localhost
APP_DB_PORT=1433
APP_DB_USERNAME=
APP_DB_PASSWORD=
APP_DB_NAME=finance-dashboard-db

# JWT auth
JWT_SECRET=
JWT_EXPIRES_IN=1d

# AES-256-GCM key (32 bytes, base64) used to encrypt each organization's stored
# Autocount DB password at rest. Generate with: npm run generate:encryption-key
CREDENTIALS_ENCRYPTION_KEY=

# Comma-separated list of allowed frontend origins for CORS.
CORS_ORIGIN=http://localhost:3000

PORT=3001

# Per-organization Autocount connection pool tuning (all optional, sane defaults apply).
# AUTOCOUNT_POOL_MAX_CACHED=50
# AUTOCOUNT_POOL_IDLE_MS=1200000
# AUTOCOUNT_POOL_SWEEP_MS=60000
# AUTOCOUNT_POOL_PER_ORG_MAX=5
# AUTOCOUNT_CONNECTION_TIMEOUT_MS=8000
# AUTOCOUNT_REQUEST_TIMEOUT_MS=30000

# Used only by scripts/create-admin.ts (run once per environment to bootstrap the first admin).
# ADMIN_EMAIL=
# ADMIN_FULL_NAME=
# ADMIN_PASSWORD=
